# Super-Logs configuration. Copy to .env and adjust.

# The URL people open the dashboard at. https:// turns on Secure cookies and HSTS,
# and requests from any other Origin are rejected.
SUPER_LOGS_PUBLIC_URL=https://logs.example.com

# First administrator, created on first boot only (ignored once any user exists).
# The password must be changed at first sign-in.
SUPER_LOGS_ADMIN_EMAIL=you@example.com
SUPER_LOGS_ADMIN_PASSWORD=change-me-at-first-login

# Raw events older than this many days are deleted (hourly cleanup).
SUPER_LOGS_RETENTION_DAYS=14

# Dashboard sessions last this long without use (hours).
#SUPER_LOGS_SESSION_TTL_HOURS=168

# Max events per minute per ingest key.
#SUPER_LOGS_INGEST_EVENTS_PER_MINUTE=6000

# Read the client IP (for sign-in rate limits only; never stored) from
# CF-Connecting-IP / X-Forwarded-For. Set to false if Super-Logs is exposed
# directly, without a proxy you control.
#SUPER_LOGS_TRUST_PROXY=true

# Optional generic JSON webhook for incident alerts. Leave unset to keep alerts local.
#SUPER_LOGS_ALERT_WEBHOOK_URL=https://alerts.example.com/super-logs
# Minimum minutes between repeated alerts for the same ongoing incident.
#SUPER_LOGS_ALERT_COOLDOWN_MINUTES=15

# Telegram alerts for EVERY project. For one project at a time, use the
# dashboard instead: Projects -> Settings -> Telegram alerts, which also finds
# the chat id for you. Setting both sends to both.
# Talk to @BotFather to create a bot and get the token, then add the bot to the
# chat and read the id from https://api.telegram.org/bot<TOKEN>/getUpdates
# Group ids are negative; a channel can be given as @channelusername instead.
# Set both, or neither.
#SUPER_LOGS_TELEGRAM_BOT_TOKEN=123456789:AAExample-TokenFromBotFather
#SUPER_LOGS_TELEGRAM_CHAT_ID=-1001234567890
# warning | error | critical — incidents below this are not sent to Telegram.
#SUPER_LOGS_TELEGRAM_MIN_LEVEL=warning
# Topic id, for forum-style supergroups only.
#SUPER_LOGS_TELEGRAM_THREAD_ID=42
# A mirror or proxy, where api.telegram.org is blocked or slow.
#SUPER_LOGS_TELEGRAM_API_BASE_URL=https://api.telegram.org

# debug | info | warning | error — the server's own stdout logs.
#SUPER_LOGS_LOG_LEVEL=info

# Outside Docker only (the image sets these):
#SUPER_LOGS_HOST=0.0.0.0
#SUPER_LOGS_PORT=3000
#SUPER_LOGS_DATA_DIR=./data
#SUPER_LOGS_DASHBOARD_DIR=./apps/dashboard/dist
