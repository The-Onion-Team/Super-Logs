{
  "name": "@super-logs/server",
  "version": "0.1.0",
  "private": true,
  "description": "Super-Logs server: ingestion API, storage and the dashboard backend.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Onion-Team/Super-Logs.git",
    "directory": "apps/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json --noEmit && node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@super-logs/shared": "0.1.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "esbuild": "^0.27.7"
  }
}
